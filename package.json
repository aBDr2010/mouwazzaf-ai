{
  "name": "mouwazzaf-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["client", "server", "shared"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=shared; if ($?) { npm run build --workspace=server; npm run build --workspace=client }",
    "install:all": "npm install --workspace=server; npm install --workspace=client"
  }
}
